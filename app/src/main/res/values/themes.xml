<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FoodieShare" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary</item>
        <item name="colorOnPrimaryContainer">@color/text_dark</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/text</item>
        <item name="colorSecondaryContainer">@color/background_cream</item>
        <item name="colorOnSecondaryContainer">@color/text_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary</item>
        <!-- Background and surface colors -->
        <item name="android:windowBackground">@color/background_cream</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_dark</item>
    </style>

    <style name="RoundedButton" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance_FoodieShare_Button_Rounded</item>
    </style>

    <style name="ShapeAppearance_FoodieShare_Button_Rounded" parent="">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Style for rounded corners - specifically named to resolve the linking error -->
    <style name="ShapeAppearanceOverlay.App.CornerSize12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance_Corner12" parent="ShapeAppearanceOverlay.App.CornerSize12" />
</resources>
