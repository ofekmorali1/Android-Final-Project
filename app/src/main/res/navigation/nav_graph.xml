<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">
    <action
        android:id="@+id/action_global_editReviewFragment"
        app:destination="@id/editReviewFragment" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.foodieshare.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_feedFragment"
            app:destination="@id/feedFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.foodieshare.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register" >
        <action
            android:id="@+id/action_registerFragment_to_feedFragment"
            app:destination="@id/feedFragment" />
    </fragment>

    <fragment
        android:id="@+id/feedFragment"
        android:name="com.example.foodieshare.ui.feed.FeedFragment"
        android:label="Feed"
        tools:layout="@layout/fragment_feed">
        <action
            android:id="@+id/action_feedFragment_to_reviewDetailFragment"
            app:destination="@id/reviewDetailFragment" />
        <action
            android:id="@+id/action_feedFragment_to_createPostFragment"
            app:destination="@id/createReviewFragment" />
        <action
            android:id="@+id/action_feedFragment_to_editReviewFragment"
            app:destination="@id/editReviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/createReviewFragment"
        android:name="com.example.foodieshare.ui.Review.CreateReviewFragment"
        android:label="Create Review"
        tools:layout="@layout/fragment_create_review" />

    <fragment
        android:id="@+id/editReviewFragment"
        android:name="com.example.foodieshare.ui.Review.EditReviewFragment"
        android:label="Edit Review"
        tools:layout="@layout/fragment_edit_review">
        <argument
            android:name="reviewId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/reviewDetailFragment"
        android:name="com.example.foodieshare.ui.Review.ReviewDetailFragment"
        android:label="Review Detail"
        tools:layout="@layout/fragment_review_detail">
        <argument
            android:name="reviewId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.foodieshare.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/myPostsFragment"
        android:name="com.example.foodieshare.ui.profile.MyReviewsFragment"
        android:label="My Posts"
        tools:layout="@layout/fragment_my_reviews" />

</navigation>
